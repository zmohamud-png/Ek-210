// Whack-a-mole starter: one button, one LED
// The LED starts ON. Pressing the button turns it OFF, and it stays off.
//
// Wiring:
//   Button: pin 2 to GND (uses the internal pull-up, no resistor needed)
//   LED:    onboard LED on pin 13 (or an external LED + 220 ohm resistor on pin 13)
//
// To add more buttons later, add a pin to each list below.

const int BUTTON_PINS[] = {2,13};
const int LED_PINS[]    = {13,14};
const int NUM_BUTTONS = sizeof(BUTTON_PINS) / sizeof(BUTTON_PINS[0]);

bool hit[NUM_BUTTONS];  // becomes true once that button has been pressed
int size of buttons 
void setup() {
  Serial.begin(9600);
  for (int i = 0; i < NUM_BUTTONS; i++) {
    pinMode(BUTTON_PINS[i], INPUT_PULLUP);
    pinMode(LED_PINS[i], OUTPUT);
    digitalWrite(LED_PINS[i], HIGH);  // start with the LED on
    hit[i] = false;
  }
  Serial.println("Ready. LED is on - press the button.");
}

void loop() {
  for (int i = 0; i < NUM_BUTTONS; i++) {
    if (!hit[i] && digitalRead(BUTTON_PINS[i]) == LOW) {
      hit[i] = true;
      digitalWrite(LED_PINS[i], LOW);  // turn this button's LED off
      Serial.print("Button ");
      Serial.print(i + 1);
      Serial.println(" hit");
    }
  }
}
